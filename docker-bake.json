{
  "variable": {
    "VERSION": {},
    "CHANNEL": {},
    "DEPS_ID": {}
  },
  "group": {
    "production": {
      "targets": [
        "server",
        "ui-production"
      ]
    },
    "staging": {
      "targets": [
        "server",
        "ui-staging"
      ]
    },
    "preview": {
      "targets": [
        "server",
        "ui-preview"
      ]
    },
    "local": {
      "targets": [
        "server",
        "ui-local"
      ]
    }
  },
  "target": {
    "common": {
      "args": {
        "PUBLIC_VERSION": "${VERSION}"
      },
      "dockerfile": "Dockerfile",
      "platforms": [
        "linux/amd64"
      ],
      "labels": {
        "org.opencontainers.image.source": "https://github.com/mission-apprentissage/bal",
        "org.opencontainers.image.licenses": "MIT"
      },
      "cache-from": [
        "type=gha,scope=${DEPS_ID}"
      ],
      "cache-to": [
        "type=gha,mode=max,scope=${DEPS_ID}"
      ]
    },
    "server": {
      "inherits": [
        "common"
      ],
      "tags": [
        "ghcr.io/mission-apprentissage/mna_bal_server:${VERSION}",
        "ghcr.io/mission-apprentissage/mna_bal_server:${CHANNEL}"
      ],
      "labels": {
        "org.opencontainers.image.description": "Server bal"
      },
      "target": "server"
    },
    "ui": {
      "inherits": [
        "common"
      ],
      "matrix": {
        "ENV": [
          "production",
          "staging",
          "preview",
          "local"
        ]
      },
      "name": "ui-${ENV}",
      "args": {
        "PUBLIC_ENV": "${ENV}"
      },
      "tags": [
        "ghcr.io/mission-apprentissage/mna_bal_ui:${VERSION}-${ENV}",
        "ghcr.io/mission-apprentissage/mna_bal_ui:${CHANNEL}-${ENV}"
      ],
      "labels": {
        "org.opencontainers.image.description": "Ui bal"
      },
      "target": "ui"
    }
  }
}
