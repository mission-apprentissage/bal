{
  "name": "mna-bal",
  "description": "[MNA] BAL",
  "repository": "https://github.com/mission-apprentissage/bal.git",
  "version": "0.0.0",
  "author": "MNA",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm"
  },
  "pnpm": {
    "overrides": {
      "chokidar": "^5.0.0",
      "handlebars": "^4.7.9",
      "fast-xml-parser": "^5.5.9",
      "@ungap/structured-clone": "1.3.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "canvas",
      "dtrace-provider",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@sentry/cli": "^2.56.1",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7"
  },
  "scripts": {
    "setup:env": ".bin/mna env:init",
    "setup:mongodb": "docker compose exec -it mongodb mongosh \"mongodb://__system:password@localhost:27017/mna-bal?authSource=local&directConnection=true\" --eval \"try { rs.status().ok } catch (e) { if (e.code === 94) {rs.initiate();} else {throw e} }\" --quiet",
    "dev": "pnpm services:start && pnpm -r --parallel run dev",
    "cli": "pnpm --filter server cli",
    "seed": ".bin/mna seed:apply",
    "deploy": ".bin/mna app:deploy",
    "build": "pnpm -r run build",
    "migrations:status": "pnpm cli migrations:status",
    "migrations:up": "pnpm cli migrations:up",
    "migrations:create": "pnpm cli migrations:create",
    "server:dev": "pnpm --filter server dev",
    "ui:dev": "pnpm --filter ui dev",
    "services:start": "docker compose up --build --remove-orphans -d --wait",
    "services:stop": "docker compose down",
    "services:clean": "pnpm services:stop && docker system prune --volumes",
    "seed:update": ".bin/mna seed:update",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "check:fix": "biome check --write .",
    "release": "semantic-release",
    "release:interactive": ".bin/mna app:release:interactive",
    "postinstall": "husky install",
    "talisman:add-exception": "pnpm node-talisman --githook pre-commit -i",
    "test": "vitest",
    "test:ci": "pnpm test --run",
    "test:ci:coverage": "pnpm test:ci --coverage.include='ui' --coverage.include='server/src' --coverage.include='shared' --coverage.provider='v8' --coverage.enabled --coverage.all --coverage.exclude='**/tests' --coverage.exclude='**/.next'",
    "test:watch": "vitest --watch",
    "typecheck": "pnpm -r --parallel run typecheck",
    "typecheck:ci": "pnpm -r run typecheck",
    "vault:edit": ".bin/mna vault:edit",
    "product:access:update": ".bin/mna product:access:update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "commander": "^14.0.1",
    "lint-staged": "^16.2.4",
    "node-talisman": "^1.29.22",
    "semantic-release": "^24.2.9",
    "semantic-release-slack-bot": "^4.0.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "pnpm-lock.yaml": [
      "pnpm dedupe"
    ]
  }
}
